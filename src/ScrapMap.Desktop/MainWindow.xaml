<Window x:Class="ScrapMap.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ScrapMap"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackground}" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="SCRAPMAP" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Mapa do seu mundo Survival" FontSize="11" Foreground="{StaticResource SecondaryText}" />
                </StackPanel>

                <ComboBox x:Name="SaveComboBox"
                          Grid.Column="2"
                          MinWidth="360"
                          VerticalAlignment="Center"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SaveComboBox_OnSelectionChanged" />

                <Button x:Name="RefreshButton"
                        Grid.Column="6"
                        VerticalAlignment="Center"
                        Content="Atualizar mapa"
                        Click="RefreshButton_OnClick" />

                <CheckBox x:Name="AutoRefreshCheckBox"
                          Grid.Column="4"
                          VerticalAlignment="Center"
                          IsChecked="False"
                          Foreground="{StaticResource PrimaryText}"
                          Content="Atualização automática (experimental)"
                          ToolTip="Desligada por segurança. Quando ativada, lê snapshots do save sem abrir o banco original." />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="MapView" DefaultBackgroundColor="#101419" />

            <Border x:Name="LoadingPanel"
                    Background="#DD101419"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="280" Height="5" IsIndeterminate="True" Foreground="{StaticResource Accent}" />
                    <TextBlock x:Name="LoadingText"
                               Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Text="Lendo o mundo…" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" Padding="14,7">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource SecondaryText}" Text="Iniciando…" />
        </Border>
    </Grid>
</Window>
